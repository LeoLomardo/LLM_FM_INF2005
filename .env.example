# Copie para .env e preencha. O .env está no .gitignore — NUNCA commite chaves.
#   cp .env.example .env

# ---------------- OpenAI (LLM via API) ----------------
OPENAI_API_KEY=
# Modelo usado na geração de variantes (replicação)
OPENAI_MODEL=gpt-4o-mini
# Opcional: endpoint compatível com OpenAI. Para o LLM local via Ollama use:
#   OPENAI_BASE_URL=http://localhost:11434/v1
#   OPENAI_MODEL=llama3.1:8b      (ou gemma2:9b etc.)
#   OPENAI_API_KEY=ollama         (qualquer valor; o Ollama ignora)
OPENAI_BASE_URL=

# ---------------- Cohere (embeddings, experimento 3) ----------------
COHERE_API_KEY=
COHERE_EMBED_MODEL=embed-english-v3.0
