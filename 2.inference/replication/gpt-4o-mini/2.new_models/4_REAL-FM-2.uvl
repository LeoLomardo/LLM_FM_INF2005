features
	weather_station
		mandatory
			measurements
				or
					pressure
					temperature
					wind_speed
					humidity
		mandatory
			data_source
				alternative
					internet
					demo
					external_services
					local_storage
		mandatory
			output_format
				alternative
					text
					web_server
					file
					mobile_app
				mandatory
					format
						alternative
							xml
							html
							plain_text
							json
				mandatory
					language
						alternative
							english
							german
							french
		optional
			alarm
				or
					freeze_point
					storm_alert
					high_wind_warning
		optional
			visualization
				or
					graph
					table
					map
constraints
	freeze_point requires temperature
	text excludes xml
	high_wind_warning requires wind_speed
	humidity excludes pressure
