features  
	cellphone  
		optional  
			wireless  
				or  
					infrared  
					bluetooth  
		mandatory  
			accu_cell  
				alternative  
					li_ion  
					ni_mh  
					ni_ca  
		mandatory  
			display  
				alternative  
					color  
					monochrome  
		mandatory  
			camera  
				optional  
					front_camera  
						or  
							5MP  
							12MP  
					rear_camera  
						alternative  
							12MP  
							48MP  
							64MP  
constraints  
	bluetooth requires li_ion  
	color excludes ni_ca  
	front_camera requires camera  
	rear_camera requires camera  
	li_ion excludes ni_mh  
