features
	weather_station
		mandatory
			measurements
				or
					pressure
					temperature
					wind_speed
					humidity
		mandatory
			data_source
				alternative
					internet
					demo
					external_services
					local_storage
		mandatory
			output_format
				alternative
					text
					web_server
					file
				mandatory
					format
						alternative
							xml
							html
							plain_text
							json
				mandatory
					language
						alternative
							english
							german
							french
		optional
			alarm
				or
					freeze_point
					storm_alert
					high_wind_alert
		optional
			data_logging
				mandatory
					log_interval
						alternative
							one_minute
							five_minutes
							ten_minutes
constraints
	freeze_point requires temperature
	text excludes xml
	high_wind_alert requires wind_speed
