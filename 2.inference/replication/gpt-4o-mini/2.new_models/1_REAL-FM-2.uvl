features
	weather_station
		mandatory
			measurements
				or
					pressure
					temperature
					wind_speed
					humidity
		mandatory
			data_source
				alternative
					internet
					demo
					external_services
					local_device
		mandatory
			output_format
				alternative
					text
					web_server
					file
				mandatory
					format
						alternative
							xml
							html
							plain_text
							json
				mandatory
					language
						alternative
							english
							german
							french
		optional
			alarm
				or
					freeze_point
					storm_alert
					tornado_warning
		optional
			data_logging
				mandatory
					log_interval
						alternative
							1_minute
							5_minutes
							10_minutes
constraints
	freeze_point requires temperature
	text excludes xml
	data_logging requires data_source
